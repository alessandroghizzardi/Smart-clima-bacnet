# Copia in .env (lo fa `npm run setup`) e adatta. Il file .env non va mai pubblicato.

# Nome mostrato nell'app, nel titolo della scheda, nella PWA e nelle notifiche
SITE_NAME=Smart Clima

# IP del gateway BACnet dell'impianto (si può cambiare anche da Altro > Impostazioni)
AC_IP=

# Porta e indirizzo del server web
#PORT=3000
#HOST=0.0.0.0

# Percorso del database SQLite (default: data/smart-clima.db)
#DB_PATH=data/smart-clima.db

# Fuso orario usato dagli scenari
#TZ=Europe/Rome

# Contatto per le notifiche push (VAPID)
#VAPID_SUBJECT=mailto:tu@example.com
